{
  "name": "uv-python-task",
  "version": "1.0.0",
  "description": "Python versions with uv",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "jest",
    "testdev": "jest --watch",
    "coverage": "jest --coverage",
    "build": "tsc -p tsconfig.build.json",
    "test-local": "export $(grep -v '^#' .env | xargs -0); bun src/uv_python.ts",
    "clean": "node -e \"require('fs').rmSync('../../../tasks/uv-python',{recursive:true,force:true})\"",
    "configure": "node -e \"for (const f of ['task.json','icon.png']) require('fs').copyFileSync(f,'../../../tasks/uv-python/'+f)\"",
    "package": "npm run clean && npm run build && ncc build dist/tasks/uv-python/src/uv_python.js -o ../../../tasks/uv-python --minify && npm run configure"
  },
  "author": "Henry Daniel Mosquera",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
