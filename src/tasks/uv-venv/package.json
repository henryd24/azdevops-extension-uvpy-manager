{
  "name": "uv-venv-task",
  "version": "1.0.0",
  "description": "Virtual environments with uv",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "jest",
    "testdev": "jest --watch",
    "coverage": "jest --coverage",
    "build": "tsc -p tsconfig.build.json",
    "test-local": "export $(grep -v '^#' .env | xargs -0); bun src/uv_venv.ts",
    "clean": "node -e \"require('fs').rmSync('../../../tasks/uv-venv',{recursive:true,force:true})\"",
    "configure": "node -e \"for (const f of ['task.json','icon.png']) require('fs').copyFileSync(f,'../../../tasks/uv-venv/'+f)\"",
    "package": "npm run clean && ncc build src/uv_venv.ts -o ../../../tasks/uv-venv --minify && npm run configure"
  },
  "author": "Henry Daniel Mosquera",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.10.0",
    "@vercel/ncc": "^0.38.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.2"
  }
}
