{
  "manifestVersion": 1,
  "id": "uvpy-manager",
  "name": "UvPy Manager",
  "description": "Install uv, manage Python versions, create virtual environments and run uv commands in your pipelines. Works on Linux, Windows and macOS agents.",
  "publisher": "hendamm",
  "version": "0.0.1",
  "public": false,
  "categories": [
    "Azure Pipelines"
  ],
  "content": {
    "details": {
      "path": "README.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/henryd24/azdevops-extension-uvpy-manager"
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services.Cloud"
    }
  ],
  "contributions": [
    {
      "id": "uv-setup-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "tasks/uv-setup"
      }
    },
    {
      "id": "uv-python-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "tasks/uv-python"
      }
    },
    {
      "id": "uv-venv-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "tasks/uv-venv"
      }
    },
    {
      "id": "uv-run-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "tasks/uv-run"
      }
    }
  ],
  "files": [
    {
      "path": "tasks"
    },
    {
      "path": "images",
      "addressable": true
    }
  ],
  "icons": {
    "default": "images/extension-icon.png"
  }
}
